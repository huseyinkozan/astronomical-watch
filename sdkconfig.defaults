# Project defaults. `sdkconfig` is generated from this file on the first build
# and is committed so that builds are reproducible.

CONFIG_IDF_TARGET="esp32s3"

# 32 MB GD25Q256. ESP-IDF supports its 32-bit addressing: the part above 16 MB
# is usable for data. Code above 16 MB would need an experimental option; keep
# the application partitions below 16 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Always-on wakes once a minute: skipping the app image check on deep-sleep wakes saves about
# 150 ms of the 0.5 s wake (docs/hardware.md, ESP32-S3). It still runs after power-on and reset.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# Updates through the portal: a new image starts "pending" and is marked valid once active mode
# has drawn its pages (main.cpp); a reset before that returns to the previous image. Deep-sleep
# wakes skip this check, so the update ends with a full restart.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi setup portal (M9): speed is not needed there. Without these IRAM optimisations the Wi-Fi
# and lwIP code stays in flash, which leaves internal RAM for the portal and keeps the RAM image
# that every deep-sleep wake loads small.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# LVGL allocates from the ESP-IDF heap instead of its own fixed 64 KB pool, which ran out with the
# large digits of the watch faces (drawing one glyph of the 170 px font takes about 13 KB).
CONFIG_LV_USE_CLIB_MALLOC=y
# The setup page shows a Wi-Fi QR code: a phone camera joins the portal's network with it.
CONFIG_LV_USE_QRCODE=y

# The main task computes the astronomy of the day (Sky::computeDay, with the neighbouring days'
# moonrises for the corner gauges); 3584 bytes overflowed at power-on (2026-11-14), and 6144
# left about 1 KB in active mode (event log, 2026-11-18).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# A stack overflow stops at once at a watchpoint on the stack's end, with a readable core dump;
# the canary check alone found it only at a task switch, after the overflow had damaged memory
# (v0.0.3: the core dump got stuck and a watchdog reset the watch).
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# A crash stores a core dump in flash, read later over USB with `idf.py coredump-info` (the watch
# runs on the wrist without a console). Not checked at boot: that would lengthen every minute
# wake; the event log checks it only after a reset.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=n
# A task that starves the idle tasks for 5 s resets the watch with a core dump, instead of only
# printing a warning to a console nobody reads on the wrist: a hung watch would otherwise stay
# awake until the battery is flat. No test log since M1 shows the warning (2026-11-21).
CONFIG_ESP_TASK_WDT_PANIC=y

# Quad flash reads, as in the Waveshare examples for this board, and 64-byte data cache lines:
# LVGL waits on flash reads (code and fonts), so this made scrolling about 1.5 times faster
# (render per frame 120 -> 80 ms; 240 MHz alone gave little, 2026-11-14).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The setup portal's traffic is light (one page, a few requests): fewer Wi-Fi buffers leave
# internal RAM for LVGL while the portal runs (it once crashed drawing with 7 KB left).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
