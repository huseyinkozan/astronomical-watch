# Project defaults. `sdkconfig` is generated from this file on the first build
# and is committed so that builds are reproducible.

CONFIG_IDF_TARGET="esp32s3"

# 32 MB GD25Q256. ESP-IDF supports its 32-bit addressing: the part above 16 MB
# is usable for data. Code above 16 MB would need an experimental option; keep
# the application partitions below 16 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Fonts for the watch face (each adds flash only, no RAM).
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Always-on wakes once a minute: skipping the app image check on deep-sleep wakes saves about
# 150 ms of the 0.5 s wake (docs/hardware.md, ESP32-S3). It still runs after power-on and reset.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# Wi-Fi setup portal (M9): speed is not needed there. Without these IRAM optimisations the Wi-Fi
# and lwIP code stays in flash, which leaves internal RAM for the portal and keeps the RAM image
# that every deep-sleep wake loads small.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
