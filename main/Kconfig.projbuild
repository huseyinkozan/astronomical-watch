menu "Astronomical Watch"

    config WATCH_DEV_LOGGING
        bool "Development logging across deep sleep"
        default y
        help
            Waits for the USB Serial/JTAG host after each key or power-on wake
            and flushes the console before deep sleep, so that no log line is
            lost while USB re-enumerates. Costs up to about 2 s of awake time
            per such wake. Timer wakes never wait.

    config WATCH_AWAKE_WINDOW_MS
        int "Awake window after the last PWR key press (ms)"
        default 10000
        help
            Development aid until the display timeout exists: the watch stays
            awake this long after boot or after the last PWR key press.

    config WATCH_DISPLAY_BRIGHTNESS
        int "Display brightness (%)"
        range 1 100
        default 50
        help
            Panel brightness in the awake window (DBV, command 0x51). AMOLED
            current grows with brightness and with the number of lit pixels.

    config WATCH_AOD_BRIGHTNESS
        int "Always-on brightness (%)"
        range 1 100
        default 10
        help
            Panel brightness of the always-on face.

    config WATCH_AOD_MINUTES
        int "Always-on duration (minutes)"
        default 30
        help
            Until the motion check exists (M6), the always-on face ends after
            this time and the watch powers off.

    config WATCH_AOD_IDLE_MODE
        bool "Always-on face in idle mode (8 colours)"
        default y
        help
            Sends Idle Mode On (39h) with the first always-on drawing. Battery
            runs E and F (docs/hardware.md) estimate about 9 mA in always-on
            with it and about 14 mA without it.

    config WATCH_QUIESCE
        bool "Put unused peripherals into their lowest-power state"
        default y
        help
            Touch sleep, panel deep standby, IMU power-down, RTC CLKOUT off,
            unused AXP2101 rails off and AXP2101 IRQs limited to the PWR key,
            once after power-on. Disable only to compare battery drain with the
            default state.

    config WATCH_CODEC_POWER_DOWN
        bool "Power the codecs down (battery test)"
        default n
        depends on WATCH_QUIESCE
        help
            Adds the ES8311/ES7210 power-down of battery run C to the sleep
            preparation. That run drained about ten times more, and so did run I
            with the I2S lines held.

    config WATCH_CODEC_WRITE_MASK
        hex "Codec writes to apply"
        default 0x7F
        range 0x01 0x7F
        depends on WATCH_CODEC_POWER_DOWN
        help
            Bit i applies entry i of the power-down table in Peripherals.cpp:
            bits 0-3 ES8311 0x14, 0x0E, 0x0D, 0x01; bits 4-6 ES7210 0x40,
            0x01, 0x06.

    config WATCH_AXP_MEASURE_OFF_IN_SLEEP
        bool "AXP2101 ADCs and fuel gauge off in deep sleep (battery test)"
        default n
        depends on WATCH_BATTERY_LOG
        help
            Battery run O: every AXP2101 ADC channel (REG30) and the fuel gauge
            (REG18 bit3) are switched off before deep sleep and on again after
            each wake, before the battery is read. Shows how much of the sleep
            drain the AXP2101 measurement circuits take. The gauge percentage
            is not valid in this run.

    config WATCH_BATTERY_LOG
        bool "Battery drain log"
        default n
        help
            Wakes on a timer, stores battery voltage and gauge percentage in
            RTC memory and sleeps again at once. A PWR key wake prints the log.
            Used to estimate the average current without a meter.

    config WATCH_BATTERY_LOG_INTERVAL_MIN
        int "Battery log interval (minutes)"
        default 15
        depends on WATCH_BATTERY_LOG

    config WATCH_BATTERY_LOG_AOD
        bool "Show the always-on face during the battery log"
        default n
        depends on WATCH_BATTERY_LOG
        help
            After the awake window the always-on face runs (make
            WATCH_AOD_MINUTES long enough), and one of its minute wakes per
            logging interval records the battery.

endmenu
