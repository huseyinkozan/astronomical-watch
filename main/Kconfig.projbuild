menu "Astronomical Watch"

    config WATCH_DEV_LOGGING
        bool "Development logging across deep sleep"
        default y
        help
            Waits for the USB Serial/JTAG host after each key or power-on wake
            and flushes the console before deep sleep, so that no log line is
            lost while USB re-enumerates. Costs up to about 2 s of awake time
            per such wake. Timer wakes never wait.

    config WATCH_AWAKE_WINDOW_MS
        int "Awake window after the last PWR key press (ms)"
        default 10000
        help
            Development aid until the display timeout exists: the watch stays
            awake this long after boot or after the last PWR key press.

    config WATCH_DISPLAY_BRIGHTNESS
        int "Display brightness (%)"
        range 1 100
        default 50
        help
            Panel brightness in the awake window (DBV, command 0x51). AMOLED
            current grows with brightness and with the number of lit pixels.

    config WATCH_AOD_BRIGHTNESS
        int "Always-on brightness (%)"
        range 1 100
        default 10
        help
            Panel brightness of the always-on face.

    config WATCH_AOD_MINUTES
        int "Always-on duration (minutes)"
        default 30
        help
            Until the motion check exists (M6), the always-on face ends after
            this time and the watch powers off.

    config WATCH_QUIESCE
        bool "Put unused peripherals into their lowest-power state"
        default y
        help
            Touch sleep, panel deep standby, IMU power-down, RTC CLKOUT off,
            unused AXP2101 rails off and AXP2101 IRQs limited to the PWR key,
            once after power-on. Disable only to compare battery drain with the
            default state.

    config WATCH_BATTERY_LOG
        bool "Battery drain log"
        default n
        help
            Wakes on a timer, stores battery voltage and gauge percentage in
            RTC memory and sleeps again at once. A PWR key wake prints the log.
            Used to estimate the average current without a meter.

    config WATCH_BATTERY_LOG_INTERVAL_MIN
        int "Battery log interval (minutes)"
        default 15
        depends on WATCH_BATTERY_LOG

endmenu
